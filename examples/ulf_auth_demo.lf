test "ULF Multi-User Load Test" {
  environment {
    authEndpoint = env("AUTH_ENDPOINT")
    baseUrl = env("BASE_URL")
  }

  target #baseUrl

  auth login {
    file
    endpoint #authEndpoint
    method POST
    body {
      username = "${username}"
      password = "${password}"
    }
    format "$.access_token"
  }
   
  variables {
    q = "phone"
    q2 = "laptop"
    expectedName = "iPhone 14"
  }

  scenario "search" {
    request GET "/catalog/search?q=${q}"
    expect status 200
    expect json $.results isArray
    expect json $.results[0].name equals #expectedName
    expect json $.results notEmpty
  }

  scenario "search again" {
    request GET "/catalog/search?q=${q2}"
    expect status 200
  }

  load {
    users 10
    rampUp 2s
    duration 10s
  }

  metrics {
    p95 < 500ms
    errorRate < 5%
  }
}